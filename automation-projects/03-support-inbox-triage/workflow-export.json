    {
      "parameters": {
        "jsCode": "// Parse Gemini's structured JSON response into clean fields\n\nfor (const item of $input.all()) {\n  const raw = item.json.content?.parts?.[0]?.text ?? item.json.text ?? item.json.output ?? item.json.data;\n\n  let parsed;\n  try {\n    parsed = typeof raw === 'string' ? JSON.parse(raw) : raw;\n  } catch (e) {\n    const match = String(raw).match(/\\{[\\s\\S]*\\}/);\n    parsed = match ? JSON.parse(match[0]) : { intent: 'other', urgency: 'medium', sentiment: 'neutral', confidence: 0, order_number: null };\n  }\n\n  item.json.intent = parsed.intent;\n  item.json.urgency = parsed.urgency;\n  item.json.sentiment = parsed.sentiment;\n  item.json.confidence = parsed.confidence;\n  item.json.order_number = parsed.order_number ?? null;\n\n  const fromRaw = $('Gmail Trigger').first().json.From || '';\n  const emailMatch = fromRaw.match(/<(.+)>/);\n  item.json.senderEmail = emailMatch ? emailMatch[1] : fromRaw.trim();\n}\n\nreturn $input.all();"
      },
