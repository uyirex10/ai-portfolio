    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const item = $('Code in JavaScript').item.json;\n\nconst buyingIntentWords = ['quote', 'price', 'pricing', 'buy', 'order', 'purchase', 'bulk'];\nconst messageLower = (item.message || '').toLowerCase();\nconst hasIntent = buyingIntentWords.some(word => messageLower.includes(word));\n\nlet score = 0;\nif (hasIntent) score += 2;\nif (item.company) score += 1;\nif (/^\\+\\d{10,15}$/.test((item.phone || '').replace(/[\\s-]/g, ''))) score += 1;\n\nlet tier;\nif (score >= 3) tier = 'Hot';\nelse if (score >= 1) tier = 'Warm';\nelse tier = 'Junk';\n\nitem.lead_score = score;\nitem.tier = tier;\n\nreturn item;"
      },
