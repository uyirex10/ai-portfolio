      "parameters": {
        "jsCode": "const rows = $input.all().map(i => i.json);\nconst oneDayAgo = new Date(Date.now() - 24 * 60 * 60 * 1000);\n\nconst recent = rows.filter(row => new Date(row['Failed At']) > oneDayAgo);\n\nconst byNode = {};\nfor (const row of recent) {\n  const node = row['Node Name'];\n  byNode[node] = (byNode[node] || 0) + 1;\n}\n\nconst summaryLines = Object.entries(byNode)\n  .map(([node, count]) => `- ${node}: ${count}`)\n  .join('\\n');\n\nreturn {\n  total_failures: recent.length,\n  summary_text: recent.length > 0\n    ? `⚠️ ${recent.length} failure(s) in the last 24h:\\n${summaryLines}`\n    : '✅ No failures in the last 24h.'\n};"
      },
