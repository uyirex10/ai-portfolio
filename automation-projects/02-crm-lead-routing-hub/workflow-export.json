    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const original = $('If').item.json;\n\nif (!original.needs_cleanup) {\n  original.cleanup_status = 'skipped_already_clean';\n  return original;\n}\n\nconst raw = $json.content.parts[0].text;\n\nlet cleaned;\ntry {\n  cleaned = JSON.parse(raw);\n  original.phone = cleaned.phone || original.phone;\n  original.company = cleaned.company || original.company;\n  original.cleanup_status = 'success';\n} catch (e) {\n  original.cleanup_status = 'failed_fallback_to_raw';\n}\n\nreturn original;"
      },
