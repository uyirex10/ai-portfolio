        },
        "text": "Extract the following fields from this invoice and return ONLY valid JSON, no other text, no markdown formatting, no explanation:\n\n{\n  \"vendor\": \"string - the company issuing the invoice\",\n  \"invoice_date\": \"string - format YYYY-MM-DD\",\n  \"currency\": \"string - e.g. USD, EUR, NGN\",\n  \"line_items\": [\n    { \"description\": \"string\", \"quantity\": number, \"unit_price\": number, \"line_total\": number }\n  ],\n  \"vat_amount\": \"number - 0 if not present\",\n  \"total\": \"number - the final invoice total\"\n}\n\nIf any field is missing or unreadable, use null for that field. Do not guess values you cannot see in the document.",
        "inputType": "binary",
        "binaryPropertyName": "attachment_0",
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.googleGemini",
      "typeVersion": 1.2,
      "position": [
        208,
        0
      ],
      "id": "9b3f1753-bdf6-48ee-933e-626a608c2d66",
      "name": "Analyze document",
      "credentials": {
        "googlePalmApi": {
          "id": "M0YhZnoxRErxJvf3",
          "name": "Google Gemini(PaLM) Api account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Get the raw text Gemini returned\nconst rawText = $input.first().json.content.parts[0].text;\n// Gemini sometimes wraps JSON in ```json fences - strip those if present\nconst cleaned = rawText.replace(/```json\\n?/g, '').replace(/```/g, '').trim();\n// Parse the string into a real JSON object\nlet invoice;\ntry {\n  invoice = JSON.parse(cleaned);\n} catch (error) {\n  // If parsing fails entirely, flag it for manual review\n  return [{\n    json: {\n      needs_review: true,\n      review_reason: \"Could not parse AI output as JSON\",\n      raw_output: rawText\n    }\n  }];\n}\n// Calculate the sum of line items to check against the stated total\nlet calculatedTotal = 0;\nlet hasNullLineItem = false;\nfor (const item of invoice.line_items || []) {\n  if (item.line_total === null || item.line_total === undefined) {\n    hasNullLineItem = true;\n  } else {\n    calculatedTotal += Number(item.line_total);\n  }\n}\n// Add VAT/tax on top of line items before comparing to stated total\nconst vat = invoice.vat_amount !== null ? Number(invoice.vat_amount) : 0;\ncalculatedTotal = Math.round((calculatedTotal + vat) * 100) / 100;\nconst statedTotal = invoice.total !== null ? Number(invoice.total) : null;\n// Decide if this invoice needs human review\nlet needsReview = false;\nlet reviewReason = \"\";\nif (statedTotal === null) {\n  needsReview = true;\n  reviewReason = \"No total found on invoice\";\n} else if (hasNullLineItem) {\n  needsReview = true;\n  reviewReason = \"One or more line items missing values\";\n} else if (Math.abs(calculatedTotal - statedTotal) > 0.05) {\n  needsReview = true;\n  reviewReason = `Line items sum to ${calculatedTotal} but stated total is ${statedTotal}`;\n}\n// Return the clean, validated result\nreturn [{\n  json: {\n    vendor: invoice.vendor,\n    invoice_date: invoice.invoice_date,\n    currency: invoice.currency,\n    line_items: invoice.line_items,\n    vat_amount: invoice.vat_amount,\n    total: invoice.total,\n    calculated_total: calculatedTotal,\n    needs_review: needsReview,\n    review_reason: reviewReason\n  }\n}];"
      },
