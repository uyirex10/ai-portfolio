# Safety net. The Dockerfile's COPY lines are explicit and already exclude these, but
# a future `COPY . .` would silently pull them in without this file.

# Secrets: set as environment variables in the Render dashboard, never baked into a
# layer, where they persist even if a later layer deletes the file.
.env
.env.*
!.env.example

# The request log. Written at run time; an image should not carry traffic history.
*.db
requests.db

# Local virtualenv: host-specific binaries, large and useless inside the image.
venv/
.venv/

# Tests run before the build, not inside the image.
test_*.py

# Python bytecode and caches.
__pycache__/
*.py[cod]

# Repo furniture with no role at run time.
.git/
.gitignore
build-guide.md
README.md
