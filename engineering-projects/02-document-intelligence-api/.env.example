# Copy to .env and fill in. .env is gitignored; this file is not.

# --- required ---------------------------------------------------------------

# Google AI Studio key for the Gemini calls.
GEMINI_API_KEY=

# Who may call the API, as name:secret pairs, comma separated. The name appears in
# the request log so you can see which client spent what; the secret is what the
# caller sends in the X-API-Key header. With this empty the service rejects every
# request, which is the safe failure for a billable endpoint.
DOCINTEL_API_KEYS=procurement:sk_live_change_me

# --- cost tracking ----------------------------------------------------------

# Published rates for the model in use, in USD per million tokens. Real values,
# not placeholders - these are public list prices, so there is no reason to make
# someone reading the repo go and look them up.
#
# Cleared, every response and log row reports cost as null while still recording
# tokens in full. Check them against current pricing when changing model: a
# cost-per-document figure quoted to a client from a stale rate is wrong silently.
DOCINTEL_PRICE_INPUT_PER_MTOK=0.25
DOCINTEL_PRICE_OUTPUT_PER_MTOK=1.50

# --- limits and storage -----------------------------------------------------

# Per client, per minute. Every accepted request makes at least two model calls,
# so this is cost control before it is abuse control.
DOCINTEL_RATE_LIMIT_PER_MINUTE=10

# Refused before the file is read into memory. 10 MB.
DOCINTEL_MAX_UPLOAD_BYTES=10485760

# SQLite request log. Ephemeral on Render's default filesystem - fine for the
# operational view, not a system of record.
DOCINTEL_LOG_DB=requests.db

# --- models -----------------------------------------------------------------

DOCINTEL_MAIN_MODEL=gemini-3.1-flash-lite
# Defaults to the main model. The second pass is cheap by virtue of a smaller
# schema and prompt, not a smaller model.
DOCINTEL_SECOND_PASS_MODEL=

# --- admin page -------------------------------------------------------------

# Guards /admin, which shows every client's spend and every filename processed.
# A separate secret from the extract keys on purpose: an integrator's key must not
# open it. Unset, the page returns 404 and is simply not enabled.
DOCINTEL_ADMIN_KEY=
