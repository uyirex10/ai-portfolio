# Copy to .env and fill in. The full reference - every variable, its default and the
# reasoning - is in the Configuration section of README.md. The notes below cover only
# the three places where a plausible-looking edit fails silently.

GEMINI_API_KEY=

# name:secret pairs, comma separated. The name is a label for the request log; the
# secret is what the caller sends in X-API-Key. An entry with no colon is skipped, so
# a bare `DOCINTEL_API_KEYS=sk_live_abc` parses to zero keys and every request is then
# refused with 401 while this file looks correctly filled in. Keep the name.
DOCINTEL_API_KEYS=procurement:sk_live_change_me

# Real published list prices, not placeholders - nothing to substitute here.
DOCINTEL_PRICE_INPUT_PER_MTOK=0.25
DOCINTEL_PRICE_OUTPUT_PER_MTOK=1.50

DOCINTEL_RATE_LIMIT_PER_MINUTE=10

DOCINTEL_MAX_UPLOAD_BYTES=10485760

DOCINTEL_LOG_DB=requests.db

DOCINTEL_MAIN_MODEL=gemini-3.1-flash-lite
DOCINTEL_SECOND_PASS_MODEL=

# Blank leaves /admin disabled, returning 404. It does not leave it open.
DOCINTEL_ADMIN_KEY=
